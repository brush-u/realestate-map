# 이 파일을 복사해서 .env 로 만들고 실제 키를 채워넣으세요.
# .env 는 절대 git / 외부에 공개하지 마세요.

PORT=3000

# 구글맵 JS SDK 로드용 (지도 렌더링, 클라이언트에 노출되는 공개 키)
# Google Cloud Console에서 HTTP 리퍼러 제한을 걸어두는 걸 권장합니다.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 카카오 로컬(Local) API용 REST 키 - developers.kakao.com > 내 애플리케이션 > 요약 정보
# (지도 렌더링용 JavaScript 키와는 다른 키입니다)
# 좌표<->주소 변환(법정동코드 조회, 단지 주소 검색)에 사용하며, 결제(빌링) 등록이 필요 없습니다.
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE

# 공공데이터포털에서 발급받은 "디코딩된(Decoding)" 서비스키
# 서버에서만 사용하고 클라이언트로는 절대 내려주지 않습니다.
MOLIT_API_KEY=YOUR_MOLIT_SERVICE_KEY_HERE
